# KanForge configuration (all optional). Copy this file to .env and fill in values.
# .env is git-ignored and must never be committed.
#
# ===========================================================================
# LLM (agent/llm.js) — sole provider: the opencode CLI. KanForge drives ALL model
# interaction through `opencode run --format json`. big-pickle is served on the
# opencode free tier, so no API key is ever needed. The model is fungible at the
# opencode layer: set KANFORGE_LLM_MODEL to any model ref opencode can serve.
# ===========================================================================
KANFORGE_LLM_PROVIDER=opencode

# Model ref for the opencode CLI (default: big-pickle).
# KANFORGE_LLM_MODEL=big-pickle

# Optional explicit path to opencode.exe; otherwise resolved from the npm global install.
# KANFORGE_LLM_OPENCODE_BIN=

# Per-request timeout in ms and retry count (only transient timeouts are retried).
# KANFORGE_LLM_TIMEOUT_MS=60000
# KANFORGE_LLM_RETRIES=2

# ===========================================================================
# Lean backends (lean/backend.js) — every backend drives the real kernel.
# ===========================================================================
# Path to the real `leanprover-community/repl` binary built at the pinned toolchain.
# Required for the repl backend and the P0.3 live resilience suite.
# KANFORGE_REPL_BIN=/abs/path/to/repl.exe
# Pinned toolchain (used to locate Lean runtime DLLs next to the repl binary, and for pins).
# KANFORGE_LEAN_TOOLCHAIN=leanprover/lean4:v4.33.0-rc1
# Override the toolchain bin dir for the repl process PATH (defaults to auto-detect in ~/.elan).
# KANFORGE_LEAN_TOOLCHAIN_BIN=
# The `lean` binary for the CLI backend (default: `lean` on PATH via elan).
# KANFORGE_LEAN_BIN=lean
