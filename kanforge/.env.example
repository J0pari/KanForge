# KanForge configuration (all optional). Copy this file to .env and fill in values.
# .env is git-ignored and must never be committed.
#
# ===========================================================================
# LLM (agent/llm.js) — provider-neutral. Provider: gemini | openai | anthropic |
# ollama | vllm | copilot | openrouter. Default (no vars set) is local ollama on
# port 11434 with NO API key needed.
# ===========================================================================
KANFORGE_LLM_PROVIDER=ollama

# Model id accepted by the provider. Leave unset for the provider default.
# KANFORGE_LLM_MODEL=qwen2.5-coder:7b
# OpenRouter free model, verified working with the proof-filling loop:
# KANFORGE_LLM_MODEL=openai/gpt-oss-20b:free

# Secret. Only set for remote providers (gemini/openai/anthropic/copilot/openrouter).
# Local providers (ollama/vllm) require none.
# KANFORGE_LLM_API_KEY=

# Optional override for the provider endpoint.
# KANFORGE_LLM_BASE_URL=http://localhost:11434/v1

# Sampling temperature (0.0 deterministic .. 1.0).
# KANFORGE_LLM_TEMPERATURE=0.2

# Per-request timeout in ms and retry count for 429/5xx/timeout.
# KANFORGE_LLM_TIMEOUT_MS=60000
# KANFORGE_LLM_RETRIES=2

# ===========================================================================
# Lean backends (lean/backend.js) — every backend drives the real kernel.
# ===========================================================================
# Path to the real `leanprover-community/repl` binary built at the pinned toolchain.
# Required for the repl backend and the P0.3 live resilience suite.
# KANFORGE_REPL_BIN=/abs/path/to/repl.exe
# Pinned toolchain (used to locate Lean runtime DLLs next to the repl binary, and for pins).
# KANFORGE_LEAN_TOOLCHAIN=leanprover/lean4:v4.33.0-rc1
# Override the toolchain bin dir for the repl process PATH (defaults to auto-detect in ~/.elan).
# KANFORGE_LEAN_TOOLCHAIN_BIN=
# The `lean` binary for the CLI backend (default: `lean` on PATH via elan).
# KANFORGE_LEAN_BIN=lean
